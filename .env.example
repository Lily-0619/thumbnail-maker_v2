# ============================================================
# APIキー設定ファイルのサンプル
#
# 使い方:
#   1. このファイルをコピーして「.env」という名前で保存する
#      (プロジェクトの一番上、main.py と同じ場所に置く)
#   2. 下の「=」の右側に自分のAPIキーを貼り付ける
#   3. .env ファイルは絶対に人に渡したりGitにアップしないこと!
#
# ※ provider に openai を使う場合は OPENAI_API_KEY だけでOK
# ============================================================

# OpenAIのAPIキー (https://platform.openai.com/api-keys で発行)
OPENAI_API_KEY=

# Stability AIのAPIキー (https://platform.stability.ai/account/keys で発行)
# ※ provider を stability にした場合のみ必要
STABILITY_API_KEY=
